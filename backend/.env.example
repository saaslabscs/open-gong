# Copy this file to backend/.env and fill in your keys.
# backend/.env is gitignored — never commit it.

# --- LLM provider (intent detection, judgment scoring, follow-up emails,
# --- custom pack compiler) ------------------------------------------------
# "anthropic" (direct) or "openrouter" (model switching + automatic fallbacks)
LLM_PROVIDER=anthropic

# Model to use. Anthropic example: claude-sonnet-5
# OpenRouter example: anthropic/claude-sonnet-5
LLM_MODEL=claude-sonnet-5

# OpenRouter only: comma-separated fallbacks tried in order if the primary
# model is down or erroring, e.g. openai/gpt-5.2,google/gemini-3-flash
LLM_FALLBACK_MODELS=

# Anthropic API key (console.anthropic.com) — used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# OpenRouter API key (openrouter.ai/keys) — used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# PyAI API key — powers real transcription/compliance (docs.pyai.com).
# Leave empty to keep using the offline mock adapter.
PYAI_API_KEY=

# Adapter: "mock" (default, offline) or "real" (requires PYAI_API_KEY, lands in M8)
PYAI_ADAPTER=mock

# Secret used to verify PyAI webhook signatures (any random string in mock mode)
PYAI_WEBHOOK_SECRET=mock-secret

# Per-run LLM spend cap in USD — breach stops the run cleanly
MAX_COST_PER_RUN=1.00
